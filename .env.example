MINDKEEP_HOST=127.0.0.1
MINDKEEP_PORT=8080
MINDKEEP_DB_HOST=127.0.0.1
MINDKEEP_DB_PORT=3306
MINDKEEP_DB_NAME=mindkeep
MINDKEEP_DB_USER=mindkeep
MINDKEEP_DB_PASSWORD=change-me
MINDKEEP_FRONTEND=frontend
MINDKEEP_DATA=data
MINDKEEP_PUBLIC_URL=http://localhost:8080
# Enable behind HTTPS in production. Never serve account data over public HTTP.
MINDKEEP_SECURE_COOKIE=0
# Absolute executable that reads a JSON email {to,subject,text} from stdin.
# Must deliver email successfully (exit 0). Example SMTP adapter: scripts/send-email.py
MINDKEEP_MAIL_COMMAND=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Actual PDF export uses headless Chromium with its normal browser sandbox.
MINDKEEP_PDF_BROWSER=/usr/bin/google-chrome
# Optional locally extracted C++ development headers/libraries.
MINDKEEP_DEPS=
